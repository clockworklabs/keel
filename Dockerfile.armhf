# Node 22.23.4 distrusts compromised eMudhra/emSign CAs (October 2026).
FROM node:22.23.4-alpine as ui

WORKDIR /app
COPY ui /app
# webpack/minifier resolutions avoid depending on OpenSSL's disabled MD4.
RUN yarn
RUN yarn run lint --no-fix
RUN yarn run build

# Bookworm receives CA trust updates and provides OpenSSL 3.
FROM arm32v7/debian:bookworm-slim
# Refresh CA trust after the emSign compromise, even if already installed.
RUN apt-get update && apt-get install --reinstall -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY cmd/keel/release/keel-linux-arm /bin/keel
COPY --from=ui /app/dist /www
VOLUME /data
ENV XDG_DATA_HOME /data

EXPOSE 9300
ENTRYPOINT ["/bin/keel"]